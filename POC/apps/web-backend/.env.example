# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/vietasr_db

# Object Storage configuration (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=False
MINIO_BUCKET_RAW=raw-uploads
MINIO_BUCKET_STANDARD=standardized-wavs

# ASR Model Server endpoints
ASR_SERVER_URL=http://localhost:8001
ASR_SERVER_WS_URL=ws://localhost:8001/api/stream

# Security & CORS limits
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_FILE_SIZE_BYTES=52428800
RATE_LIMIT_PER_MINUTE=60
